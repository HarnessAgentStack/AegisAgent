# =============================================================================
# Aegis Platform - 环境变量模板
# -----------------------------------------------------------------------------
# 用途：docker-compose 读取本文件为容器注入环境变量。
# 使用：复制为 .env 并按需修改（cp .env.example .env）。
#       .env 已被 .gitignore 忽略，不会提交；请勿将真实密钥提交到仓库。
# 安全：所有带 #CHANGE 的项必须修改为强随机值，生产环境禁止使用示例值。
#
# 说明：标 [compose] 的变量被 docker-compose 直接读取；
#       标 [prod] 的变量仅在源码/裸机部署（激活 prod profile）时需要，
#       compose 部署下应用容器的主机地址已由 docker-compose.app.yml 内置。
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL [compose]（root 密码供 MySQL 容器初始化；业务账号供应用连接）
# -----------------------------------------------------------------------------
DB_ROOT_PASSWORD=root123              # root 超级密码 #CHANGE
DB_USER=aegis                         # 业务库专用账号
DB_PASSWORD=aegis123                  # 业务库密码 #CHANGE
DB_NAME=aegis                         # 业务库名（与 01_schema_init.sql 一致）

# MySQL [prod]（源码/裸机部署时应用连接用；compose 下已内置 mysql:3306）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USE_SSL=false                    # 生产建议 true

# -----------------------------------------------------------------------------
# Redis [compose]（密码可选；主机/端口 compose 已内置 redis:6379）
# -----------------------------------------------------------------------------
REDIS_PASSWORD=                       # 生产强烈建议设置密码 #CHANGE

# Redis [prod]（源码/裸机部署用）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# AgentScope 框架分布式存储 Redis（缺省复用 REDIS_HOST；独立部署时才需设置）
# UPON_REDIS_HOST=127.0.0.1
# UPON_REDIS_PORT=6379
# UPON_REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# MinIO [compose]（对象存储：附件 / MCP 文件 / 知识库原文 / 沙箱快照）
# -----------------------------------------------------------------------------
MINIO_ACCESS_KEY=aegis                # #CHANGE
MINIO_SECRET_KEY=aegis12345           # #CHANGE（≥8 位）

# MinIO [prod]（源码/裸机部署用；compose 已内置 http://minio:9000）
# MINIO_ENDPOINT=http://127.0.0.1:9000

# -----------------------------------------------------------------------------
# JWT 签名密钥（HS256，UTF-8 字节 ≥ 32 字符）[compose 必填]
# -----------------------------------------------------------------------------
# 生产必须修改！可用 openssl rand -base64 48 生成
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-chars!  # #CHANGE

# -----------------------------------------------------------------------------
# 可观测性 [compose]（observability profile）
# -----------------------------------------------------------------------------
GRAFANA_PASSWORD=admin123             # Grafana 管理员密码 #CHANGE

# -----------------------------------------------------------------------------
# 沙箱（运行时代码执行环境）[compose 可选]
# -----------------------------------------------------------------------------
# local -> 沙箱 backend=docker（纯 Docker 部署，默认）；留空 -> k8s 生产模式
SPRING_PROFILES_ACTIVE=local
# Docker 沙箱宿主（Windows Docker Desktop 用 npipe；Linux/Mac 用 unix:///var/run/docker.sock）
# SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
# PaddleOCR 服务地址（启用 --profile ocr 时默认 http://aegis-paddleocr:8000）
# AEGIS_OCR_PADDLE_ENDPOINT=http://aegis-paddleocr:8000

# -----------------------------------------------------------------------------
# 模型 Provider（不入本文件）
# -----------------------------------------------------------------------------
# model_provider.api_key 属敏感信息，部署后在 admin 页面「模型管理 -> 提供商」配置
