<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aegis</groupId>
        <artifactId>aegis-platform-backend</artifactId>
        <version>0.1.0-alpha.1</version>
    </parent>

    <artifactId>aegis-core</artifactId>
    <packaging>pom</packaging>
    <name>aegis-core</name>
    <description>Aegis Core: aggregator pom for core-domain / core-spi / core-infra</description>

    <modules>
        <module>aegis-core-domain</module>
        <module>aegis-core-spi</module>
        <module>aegis-core-infra</module>
    </modules>

    <dependencies>
        <!-- Lombok：全模块通用注解 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 三子模块：应用模块通过本 pom 传递获取所有核心能力 -->
        <dependency>
            <groupId>com.aegis</groupId>
            <artifactId>aegis-core-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aegis</groupId>
            <artifactId>aegis-core-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aegis</groupId>
            <artifactId>aegis-core-infra</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

</project>
