        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.aegis</groupId>
    <artifactId>aegis-platform-backend</artifactId>
    <version>0.1.0-alpha.1</version>
    <packaging>pom</packaging>
    <name>aegis-platform-backend</name>
    <description>Aegis Platform Backend Aggregator</description>

    <modules>
        <module>aegis-core</module>
        <module>aegis-dal</module>
        <module>aegis-gateway</module>
        <module>aegis-runtime</module>
        <module>aegis-admin</module>
        <module>aegis-mcp-demo</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <lombok.version>1.18.36</lombok.version>
        <spring-cloud.version>2025.1.0</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <minio.version>8.5.14</minio.version>
        <milvus.version>2.5.0</milvus.version>
        <mysql.version>8.0.32</mysql.version>
        <protobuf.version>3.24.0</protobuf.version>
        <redisson.version>3.37.0</redisson.version>
        <fabric8.version>7.4.0</fabric8.version>
        <poi.version>5.3.0</poi.version>
        <pdfbox.version>2.0.32</pdfbox.version>
        <fastjson2.version>2.0.57</fastjson2.version>
        <agentscope.version>2.0.2</agentscope.version>
        <jjwt.version>0.12.6</jjwt.version>
        <jackson.version>2.18.2</jackson.version>
        <tabula.version>1.0.5</tabula.version>
        <jsoup.version>1.18.1</jsoup.version>
        <docker-java.version>3.4.1</docker-java.version>
        <archunit.version>1.3.0</archunit.version>
        <spring-ai.version>2.0.0-M1</spring-ai.version>
    </properties>

    <dependencyManagement>
