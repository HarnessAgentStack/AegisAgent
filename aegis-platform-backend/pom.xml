                <artifactId>aegis-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aegis</groupId>
                <artifactId>aegis-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
